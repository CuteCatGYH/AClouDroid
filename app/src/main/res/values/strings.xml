    <!-- Local Albums Permission Dialogs -->
    <string name="backup_perm_bg_title">提示: 开启常驻后台更稳定</string>
    <string name="backup_perm_bg_desc">我们检测到您正在开启自动备份。\n\n为了确保照片能及时、稳定地在后台实时上传，是否允许 iClouDroid 忽略电池优化，保持常驻后台运行？\n\n如果不开启，系统可能会在息屏后暂停备份，需要重新打开应用才会继续。</string>
    <string name="backup_perm_bg_toast_unsupported">设备不支持直接跳转，请到系统设置中手动开启</string>
    <string name="backup_perm_bg_btn_enable">去开启</string>
    <string name="backup_perm_bg_btn_skip">暂不需要</string>

    <string name="backup_perm_media_title">管理本地媒体文件夹</string>
    <string name="backup_perm_media_desc">浏览各相册（如相机、微信、截屏、下载等）需要获取设备媒体文件的读取权限。后续可为您开启特定文件夹的自动增量云备份。</string>
    <string name="backup_perm_media_btn_allow">允许媒体访问</string>
    <string name="backup_perm_media_btn_settings">权限设置</string>

    <string name="backup_perm_location_title">备份时包含照片位置？</string>
    <string name="backup_perm_location_desc_1">开启备份需要「读取媒体位置」权限。它不会获取你的实时位置，只能读出照片/视频拍摄时已记录的坐标。</string>
    <string name="backup_perm_location_desc_2">允许后：云端照片和视频会带有拍摄地点，在 iPhone、Mac 上能看到地图。</string>
    <string name="backup_perm_location_desc_3">不允许：备份照常进行，只是不包含位置。</string>
    <string name="backup_perm_location_btn_allow">允许</string>
    <string name="backup_perm_location_btn_without">不带位置备份</string>
    <string name="backup_perm_location_btn_cancel">取消</string>

    <string name="backup_perm_location_denied_title">位置权限已被拒绝</string>
    <string name="backup_perm_location_denied_desc">这个权限不会出现在系统设置里，App 也无法再次弹窗申请。如果确实需要备份位置，只能卸载重装后再授权。\n\n备份本身不受影响，目前只缺少照片和视频的拍摄地点。</string>
    <string name="backup_perm_location_denied_confirm">知道了</string>
    <string name="backup_perm_location_banner">未授予定位信息权限，备份将丢失 GPS</string>
    <string name="backup_perm_location_banner_btn">授权</string>

    <!-- Xiaomi PhotoPicker Guidance Dialog -->
    <string name="xiaomi_privacy_dialog_title">小米系统特别提示</string>
    <string name="xiaomi_privacy_dialog_desc">小米 HyperOS / MIUI 系统的“安全访问”选图弹窗默认开启了隐私保护（抹去位置/拍摄信息）。由于系统选图组件预处理组件缺陷，选图确认时会导致下载进度卡在 0%。\n\n**解决方法**：请在选图弹窗中关闭“抹去照片位置”和“抹去照片拍摄信息”开关：</string>
    <string name="xiaomi_privacy_step1_desc">步骤 1：点击选图弹窗右上角设置图标</string>
    <string name="xiaomi_privacy_step2_desc">步骤 2：关闭“抹去照片位置”与“抹去照片拍摄信息”</string>
    <string name="xiaomi_privacy_root_notice_desc">如果你的设备具有 root 权限，可通过以下命令开启被小米隐藏的云端媒体选择器设置入口：</string>
    <string name="xiaomi_privacy_root_cmd">adb shell su -c \'pm enable com.android.providers.media.module/com.android.providers.media.photopicker.PhotoPickerSettingsActivity\'</string>
    <string name="xiaomi_privacy_btn_copy_cmd">复制 Root 命令</string>
    <string name="xiaomi_privacy_cmd_copied">已复制 Root 命令到剪贴板</string>
    <string name="xiaomi_privacy_btn_confirm">我知道了</string>
